<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PackagingCountVerifier.App">

    <Application.Resources>

        <!-- 🎨 COLOR PALETTE -->
        <Color x:Key="BgDark">#121212</Color>
        <Color x:Key="CardDark">#1E1E1E</Color>
        <Color x:Key="Primary">#7C6DFF</Color>
        <Color x:Key="Success">#2ECC71</Color>
        <Color x:Key="Danger">#E74C3C</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#B0B0B0</Color>

        <!-- 🔠 TEXT STYLES -->
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="TitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        </Style>

        <!-- 🧱 CARD -->
        <Style x:Key="Card" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{StaticResource CardDark}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HasShadow" Value="False" />
        </Style>

        <!-- 🔘 BUTTON -->
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="56" />
        </Style>

    </Application.Resources>
</Application>
