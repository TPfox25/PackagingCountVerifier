<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PackagingCountVerifier.PackingPage"
             Title="Live Packing"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <!-- PAGE TITLE -->
            <Label Text="Live Packing"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- ✅ BOX COMPLETED BANNER (NON-BLOCKING) -->
            <Frame x:Name="BoxCompletedBanner"
                   IsVisible="False"
                   BackgroundColor="#1E3A2F"
                   CornerRadius="16"
                   Padding="14"
                   HasShadow="False">

                <Label x:Name="BoxCompletedLabel"
                       FontSize="14"
                       TextColor="#7CFFB2"
                       HorizontalTextAlignment="Center" />
            </Frame>

            <!-- CURRENT BOX -->
            <Frame BackgroundColor="#1E1E1E"
                   CornerRadius="20"
                   Padding="24"
                   HasShadow="False">

                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="Current Box"
                           FontSize="14"
                           TextColor="#B0B0B0" />

                    <Label Text="{Binding Job.CurrentBoxCount}"
                           FontSize="56"
                           FontAttributes="Bold"
                           TextColor="#7C6DFF" />
                </VerticalStackLayout>
            </Frame>

            <!-- STATS -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                <Frame BackgroundColor="#1E1E1E"
                       CornerRadius="16"
                       Padding="16"
                       HasShadow="False">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Total Packed"
                               FontSize="13"
                               TextColor="#B0B0B0" />
                        <Label Text="{Binding Job.PackedTotal}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#1E1E1E"
                       CornerRadius="16"
                       Padding="16"
                       HasShadow="False">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Boxes Completed"
                               FontSize="13"
                               TextColor="#B0B0B0" />
                        <Label Text="{Binding Job.BoxesCompleted}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- ADD ITEMS -->
            <Frame BackgroundColor="#1E1E1E"
                   CornerRadius="18"
                   Padding="20"
                   HasShadow="False">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Add Items to Box"
                           FontSize="14"
                           TextColor="#B0B0B0" />

                    <!-- PRESETS -->
                    <HorizontalStackLayout Spacing="12"
                                           BindableLayout.ItemsSource="{Binding Presets}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding StringFormat='+{0}'}"
                                        CommandParameter="{Binding}"
                                        Clicked="OnAddPresetClicked"
                                        BackgroundColor="#7C6DFF"
                                        TextColor="White"
                                        CornerRadius="14"
                                        HeightRequest="44" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- MANUAL ENTRY -->
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Manual Quantity"
                               FontSize="13"
                               TextColor="#B0B0B0" />

                        <Entry x:Name="ManualQuantityEntry"
                               Placeholder="Enter quantity (e.g. 3)"
                               Keyboard="Numeric"
                               TextColor="White"
                               BackgroundColor="#2A2A2A"
                               HeightRequest="50" />

                        <Button Text="Add"
                                HeightRequest="56"
                                CornerRadius="14"
                                BackgroundColor="#7C6DFF"
                                TextColor="White"
                                Clicked="OnAddManualClicked" />

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- FINISH -->
            <Button Text="Finish Packing"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="14"
                    BackgroundColor="#2C2C2C"
                    TextColor="#B0B0B0"
                    Clicked="OnFinishClicked"
                    IsEnabled="{Binding Job.CanFinishPacking}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
