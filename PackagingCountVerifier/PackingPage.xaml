<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PackagingCountVerifier.PackingPage"
             Title="Live Packing"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="24" Spacing="24">

        <!-- PAGE TITLE -->
        <Label Text="Live Packing"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center" />

        <!-- CURRENT BOX CARD -->
        <Frame BackgroundColor="#1E1E1E"
               CornerRadius="20"
               Padding="24"
               HasShadow="False">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                <Label Text="Current Box"
                       FontSize="14"
                       TextColor="#B0B0B0"
                       HorizontalOptions="Center" />

                <Label Text="{Binding CurrentBoxCount}"
                       FontSize="56"
                       FontAttributes="Bold"
                       TextColor="#7C6DFF"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </Frame>

        <!-- STATS ROW -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

            <Frame BackgroundColor="#1E1E1E"
                   CornerRadius="16"
                   Padding="16"
                   HasShadow="False"
                   Grid.Column="0">

                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="Total Packed"
                           FontSize="13"
                           TextColor="#B0B0B0" />
                    <Label Text="{Binding PackedTotal}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="#1E1E1E"
                   CornerRadius="16"
                   Padding="16"
                   HasShadow="False"
                   Grid.Column="1">

                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="Boxes Completed"
                           FontSize="13"
                           TextColor="#B0B0B0" />
                    <Label Text="{Binding BoxesCompleted}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Frame>

        </Grid>

        <!-- PRIMARY ACTION -->
        <Button Text="+1 ITEM"
                FontSize="24"
                HeightRequest="72"
                CornerRadius="18"
                BackgroundColor="#7C6DFF"
                TextColor="White"
                Clicked="OnAddItemClicked" />

        <!-- SECONDARY ACTION -->
        <Button Text="Finish Packing"
                FontSize="16"
                HeightRequest="50"
                CornerRadius="14"
                BackgroundColor="#2C2C2C"
                TextColor="#B0B0B0"
                Clicked="OnFinishClicked" />

    </VerticalStackLayout>
</ContentPage>
