<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PackagingCountVerifier.BoxConfigPage"
             Title="Box Configuration"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <!-- PAGE TITLE -->
            <Label Text="Box Configuration"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- CONFIG CARD -->
            <Frame BackgroundColor="#1E1E1E"
                   CornerRadius="18"
                   Padding="20"
                   HasShadow="False">

                <VerticalStackLayout Spacing="18">

                    <Label Text="Packing Rules"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <!-- ITEMS PER BOX -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Items per box"
                               FontSize="13"
                               TextColor="#B0B0B0" />

                        <Entry Placeholder="e.g. 50"
                               Keyboard="Numeric"
                               Text="{Binding ItemsPerBox, Mode=TwoWay}"
                               FontSize="16"
                               TextColor="White" />
                    </VerticalStackLayout>

                    <!-- EXPECTED BOXES -->
                    <Frame BackgroundColor="#2A2A2A"
                           CornerRadius="14"
                           Padding="14"
                           HasShadow="False">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Expected Boxes"
                                   FontSize="13"
                                   TextColor="#B0B0B0" />

                            <Label Text="{Binding ExpectedBoxes}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#7C6DFF"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>

                    </Frame>

                </VerticalStackLayout>
            </Frame>

            <!-- PRIMARY ACTION -->
            <Button Text="Next"
                    FontSize="18"
                    HeightRequest="56"
                    CornerRadius="14"
                    BackgroundColor="#7C6DFF"
                    TextColor="White"
                    Clicked="OnStartPackingClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
