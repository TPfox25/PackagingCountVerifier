<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PackagingCountVerifier.PackingPage"
             Title="Live Packing"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <!-- PAGE TITLE -->
            <Label Text="Live Packing"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- CURRENT BOX -->
            <Frame BackgroundColor="#1E1E1E"
                   CornerRadius="20"
                   Padding="24"
                   HasShadow="False">

                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="Current Box"
                           FontSize="14"
                           TextColor="#B0B0B0" />

                    <Label Text="{Binding Job.CurrentBoxCount}"
                           FontSize="56"
                           FontAttributes="Bold"
                           TextColor="#7C6DFF" />
                </VerticalStackLayout>
            </Frame>

            <!-- STATS -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                <Frame BackgroundColor="#1E1E1E"
                       CornerRadius="16"
                       Padding="16"
                       HasShadow="False">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Total Packed"
                               FontSize="13"
                               TextColor="#B0B0B0" />
                        <Label Text="{Binding Job.PackedTotal}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="#1E1E1E"
                       CornerRadius="16"
                       Padding="16"
                       HasShadow="False">

                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="Boxes Completed"
                               FontSize="13"
                               TextColor="#B0B0B0" />
                        <Label Text="{Binding Job.BoxesCompleted}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- ADD ITEMS -->
            <Frame BackgroundColor="#1E1E1E"
                   CornerRadius="18"
                   Padding="20"
                   HasShadow="False">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Add Items to Box"
                           FontSize="14"
                           TextColor="#B0B0B0" />

                    <!-- PRESETS -->
                    <HorizontalStackLayout Spacing="12"
                        BindableLayout.ItemsSource="{Binding Presets}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding StringFormat='+{0}'}"
                                        CommandParameter="{Binding}"
                                        Clicked="OnAddPresetClicked"
                                        BackgroundColor="#7C6DFF"
                                        TextColor="White"
                                        CornerRadius="14"/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- MANUAL ENTRY -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Entry x:Name="ManualQuantityEntry"
                               Placeholder="Enter quantity"
                               Keyboard="Numeric"
                               TextColor="White"/>

                        <Button Text="Add"
                                Clicked="OnAddManualClicked"
                                BackgroundColor="#7C6DFF"
                                TextColor="White"/>
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- FINISH -->
            <Button Text="Finish Packing"
                    FontSize="16"
                    HeightRequest="50"
                    CornerRadius="14"
                    BackgroundColor="#2C2C2C"
                    TextColor="#B0B0B0"
                    Clicked="OnFinishClicked"
                    IsEnabled="{Binding Job.CanFinishPacking}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
